---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import ThemeScript from '../components/ThemeScript.astro';
import favicon from '../assets/favicon.svg';
import favicon96 from '../assets/favicon-96x96.png';
import faviconIco from '../assets/favicon.ico';
import appleIcon from '../assets/apple-touch-icon.png';
import siteManifest from '../assets/site.webmanifest';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <ThemeScript />
    <title>Participant Consent Form — William L. Anderson</title>
    <link rel="icon" type="image/png" href={favicon96.src} sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href={favicon.src} />
    <link rel="shortcut icon" href={faviconIco.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleIcon.src} />
    <link rel="manifest" href={siteManifest.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="container">
      <header class="subheader">
        <a href="/" class="subheader-name">William L. Anderson</a>
        <Nav />
      </header>

      <h1 class="page-title">Participant Consent Form</h1>
      <p class="page-subtitle">
        Study ref. ASH-001 &middot; Principal Investigator: W. L. Anderson &middot; Ethics approval: pending, optimistically
      </p>

      <div class="page-body">
        <p>
          You are being invited to take part in a research study, working title
          <em>An Evening Out: A Single-Participant Trial</em>. Before you decide, it is
          important that you understand why the research is being proposed and what it
          will involve. Please read the following information carefully. Participation
          is entirely voluntary, though the investigator is quietly hoping.
        </p>

        <form id="consent-form" novalidate>
          <fieldset class="consent-section">
            <legend>Section 1 — Choice of Intervention</legend>
            <p class="section-note">The participant will be allocated to exactly one (1) study arm of her choosing.</p>
            <label class="choice">
              <input type="radio" name="activity" value="Dinner" />
              <span class="choice-text"><strong>Dinner</strong> <em>— one evening meal; candlelight subject to availability.</em></span>
            </label>
            <label class="choice">
              <input type="radio" name="activity" value="Drinks" />
              <span class="choice-text"><strong>Drinks</strong> <em>— beverages of the participant's choosing; conversation provided at no extra cost.</em></span>
            </label>
            <label class="choice">
              <input type="radio" name="activity" value="The theatre" />
              <span class="choice-text"><strong>The theatre</strong> <em>— culture, drama, and strong opinions at the interval.</em></span>
            </label>
          </fieldset>

          <fieldset class="consent-section" id="dietary-section" hidden>
            <legend>Section 1.1 — Dietary Disclosures</legend>
            <p class="section-note">Applicable to the dinner arm only. Full disclosure ensures no adverse events at the table.</p>
            <label class="field-label" for="dietary">The participant's dietary preferences and/or requirements:</label>
            <textarea
              id="dietary"
              name="dietary"
              rows="3"
              placeholder="vegetarian, allergies, strongly held views on coriander, etc."></textarea>
          </fieldset>

          <fieldset class="consent-section">
            <legend>Section 2 — Preferred Study Site</legend>
            <p class="section-note">All sessions take place in London. The participant may indicate a preferred region.</p>
            <div class="choice-grid">
              <label class="choice"><input type="radio" name="region" value="North London" /><span class="choice-text">North</span></label>
              <label class="choice"><input type="radio" name="region" value="East London" /><span class="choice-text">East</span></label>
              <label class="choice"><input type="radio" name="region" value="South London" /><span class="choice-text">South</span></label>
              <label class="choice"><input type="radio" name="region" value="West London" /><span class="choice-text">West</span></label>
              <label class="choice"><input type="radio" name="region" value="Central London" /><span class="choice-text">Central</span></label>
              <label class="choice"><input type="radio" name="region" value="No preference — investigator's discretion" /><span class="choice-text">Investigator's discretion</span></label>
            </div>
          </fieldset>

          <fieldset class="consent-section">
            <legend>Section 3 — Availability of the Participant</legend>
            <p class="section-note">Please indicate all sessions the participant is able to attend.</p>
            <label class="choice"><input type="checkbox" name="availability" value="Friday 15 August" /><span class="choice-text">Friday 15 August</span></label>
            <label class="choice"><input type="checkbox" name="availability" value="Sunday 17 August" /><span class="choice-text">Sunday 17 August</span></label>
            <label class="choice"><input type="checkbox" name="availability" value="Monday 18 August" /><span class="choice-text">Monday 18 August</span></label>
            <label class="choice"><input type="checkbox" name="availability" value="Tuesday 19 August" /><span class="choice-text">Tuesday 19 August</span></label>
            <label class="choice"><input type="checkbox" name="availability" value="None of the above" id="avail-none" /><span class="choice-text"><em>None of the above — the participant regretfully declines all proposed sessions.</em></span></label>
          </fieldset>

          <fieldset class="consent-section">
            <legend>Section 4 — Declaration of the Participant</legend>
            <label class="choice">
              <input type="checkbox" id="consent-box" name="consent" />
              <span class="choice-text">
                I confirm that I have read and understood the above, that participation is
                entirely voluntary, and that I am free to withdraw at any time (though the
                investigator sincerely hopes I won't).
              </span>
            </label>
            <label class="field-label" for="signature">Signature of participant <em>(typed name will do — this is science, not law)</em>:</label>
            <input type="text" id="signature" name="signature" autocomplete="off" placeholder="Sign here" />
          </fieldset>

          <p class="form-error" id="form-error" hidden></p>

          <div class="form-actions">
            <button type="submit" class="submit-button">Consent &amp; Submit</button>
            <p class="form-hint">
              Submitting opens your mail app with your responses addressed to the
              investigator — press send to complete enrolment.
            </p>
          </div>
        </form>
      </div>

      <p class="back-link"><a href="/">← Back to home</a></p>

      <footer class="site-footer">
        <p>© 2026 William L. Anderson</p>
      </footer>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('consent-form') as HTMLFormElement | null;
        if (!form) return;

        const dietarySection = document.getElementById('dietary-section') as HTMLFieldSetElement;
        const activityRadios = form.querySelectorAll<HTMLInputElement>('input[name="activity"]');
        activityRadios.forEach(function (radio) {
          radio.addEventListener('change', function () {
            dietarySection.hidden = radio.value !== 'Dinner';
          });
        });

        // "None of the above" is mutually exclusive with the actual dates.
        const noneBox = document.getElementById('avail-none') as HTMLInputElement;
        const availBoxes = form.querySelectorAll<HTMLInputElement>('input[name="availability"]');
        availBoxes.forEach(function (box) {
          box.addEventListener('change', function () {
            if (box === noneBox && noneBox.checked) {
              availBoxes.forEach(function (b) { if (b !== noneBox) b.checked = false; });
            } else if (box !== noneBox && box.checked) {
              noneBox.checked = false;
            }
          });
        });

        form.addEventListener('submit', function (event) {
          event.preventDefault();
          const errorEl = document.getElementById('form-error') as HTMLParagraphElement;

          const activity = form.querySelector<HTMLInputElement>('input[name="activity"]:checked');
          const region = form.querySelector<HTMLInputElement>('input[name="region"]:checked');
          const availability = Array.from(
            form.querySelectorAll<HTMLInputElement>('input[name="availability"]:checked')
          ).map(function (b) { return b.value; });
          const consent = (document.getElementById('consent-box') as HTMLInputElement).checked;
          const dietary = (document.getElementById('dietary') as HTMLTextAreaElement).value.trim();
          const signature = (document.getElementById('signature') as HTMLInputElement).value.trim();

          const problems: string[] = [];
          if (!activity) problems.push('an intervention must be selected (Section 1)');
          if (!region) problems.push('a study site must be indicated (Section 2)');
          if (availability.length === 0) problems.push('availability must be declared (Section 3)');
          if (!consent) problems.push('the declaration must be ticked (Section 4)');

          if (problems.length > 0) {
            errorEl.hidden = false;
            errorEl.textContent =
              'The ethics committee has returned this form: ' + problems.join('; ') + '.';
            return;
          }
          errorEl.hidden = true;

          const lines = [
            'PARTICIPANT CONSENT FORM — Study ref. ASH-001',
            '',
            'Section 1 — Choice of intervention: ' + activity!.value,
          ];
          if (activity!.value === 'Dinner') {
            lines.push('Section 1.1 — Dietary disclosures: ' + (dietary || 'none declared'));
          }
          lines.push('Section 2 — Preferred study site: ' + region!.value);
          lines.push('Section 3 — Availability: ' + availability.join(', '));
          lines.push('Section 4 — Consent: given, voluntarily and in good humour');
          lines.push('Signature of participant: ' + (signature || '(unsigned, but the sentiment was there)'));

          const user = 'william.lewis.anderson';
          const domain = 'gmail';
          const tld = 'com';
          const mailto =
            'mailto:' + user + '@' + domain + '.' + tld +
            '?subject=' + encodeURIComponent('Participant Consent Form — ASH-001') +
            '&body=' + encodeURIComponent(lines.join('\n'));
          window.location.href = mailto;
        });
      });
    </script>
  </body>
</html>

<style>
  .consent-section {
    margin: 0 0 1.75rem;
    padding: 1.4rem 1.5rem 1.5rem;
    background: var(--bg-warm);
    border: 1px solid var(--rule);
  }

  .consent-section legend {
    font-family: var(--serif-display);
    font-variant: small-caps;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent);
    padding: 0 0.6rem;
  }

  .section-note {
    font-family: var(--serif-display);
    font-style: italic;
    font-size: 0.93rem;
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .choice {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    margin-bottom: 0.7rem;
    cursor: pointer;
  }

  .choice:last-child {
    margin-bottom: 0;
  }

  .choice input {
    accent-color: var(--accent);
    flex-shrink: 0;
    transform: translateY(0.1em);
    cursor: pointer;
  }

  .choice-text {
    font-size: 1rem;
    line-height: 1.55;
  }

  .choice-text em {
    color: var(--muted);
  }

  .choice-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.35rem 1.5rem;
  }

  .choice-grid .choice {
    margin-bottom: 0.35rem;
  }

  .field-label {
    display: block;
    font-size: 0.98rem;
    margin: 1rem 0 0.5rem;
  }

  .field-label em {
    color: var(--muted);
    font-size: 0.9rem;
  }

  textarea,
  input[type='text'] {
    width: 100%;
    padding: 0.6rem 0.75rem;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--rule);
    font-family: var(--serif-body);
    font-size: 1rem;
    line-height: 1.55;
    resize: vertical;
    transition: border-color 0.25s ease;
  }

  textarea:focus,
  input[type='text']:focus {
    outline: none;
    border-color: var(--accent);
  }

  input#signature {
    font-family: var(--serif-display);
    font-style: italic;
  }

  .form-error {
    font-family: var(--serif-display);
    font-style: italic;
    color: var(--accent);
    font-size: 0.95rem;
    margin: 0 0 1.25rem;
  }

  .form-actions {
    text-align: center;
    margin-top: 2rem;
  }

  .submit-button {
    font-family: var(--serif-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--bg);
    background: var(--accent);
    border: 1px solid var(--accent);
    padding: 0.7rem 2.25rem;
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .submit-button:hover,
  .submit-button:focus-visible {
    background: var(--accent-soft);
    border-color: var(--accent-soft);
    outline: none;
  }

  .form-hint {
    font-family: var(--serif-display);
    font-style: italic;
    font-size: 0.88rem;
    color: var(--muted);
    margin: 0.9rem 0 0;
  }

  @media (max-width: 640px) {
    .choice-grid {
      grid-template-columns: 1fr;
    }
    .consent-section {
      padding: 1.1rem 1.1rem 1.25rem;
    }
  }
</style>
