---
import '../styles/global.css';
import { Image } from 'astro:assets';
import Nav from '../components/Nav.astro';
import ThemeScript from '../components/ThemeScript.astro';
import profilePic from '../assets/me.jpg';
import favicon from '../assets/favicon.svg';
import favicon96 from '../assets/favicon-96x96.png';
import faviconIco from '../assets/favicon.ico';
import appleIcon from '../assets/apple-touch-icon.png';
import siteManifest from '../assets/site.webmanifest';
import faviconMats from '../assets/favicons/mats.png';
import faviconXlab from '../assets/favicons/xlab.ico?url';
import faviconWaisi from '../assets/favicons/waisi.png';
import faviconCoopAI from '../assets/favicons/cooperativeai.png';
import faviconWittLab from '../assets/favicons/wittlab.png';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ThemeScript />
    <title>William L. Anderson</title>
    <link rel="icon" type="image/png" href={favicon96.src} sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href={favicon.src} />
    <link rel="shortcut icon" href={faviconIco.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleIcon.src} />
    <link rel="manifest" href={siteManifest.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IM+Fell+English+SC&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="container">
      <header class="hero">
        <div class="hero-top">
          <div class="profile-pic">
            <Image src={profilePic} alt="William L. Anderson" width={320} height={320} />
          </div>
          <div class="hero-title">
            <h1>William L. Anderson</h1>
            <div id="email-container" class="email">
              <noscript>[first].[last] [at] cooperativeai [dot] org</noscript>
            </div>
            <Nav />
          </div>
        </div>
        <div class="bio">
          <p>
            Hi, I’m Will! I work on multi-agent AI safety and technical governance at the <a href="https://www.cooperativeai.com/foundation" target="_blank" rel="noopener noreferrer">Cooperative AI Foundation</a><img src={faviconCoopAI.src} alt="" class="org-favicon" aria-hidden="true" />. I've built <a href="https://arxiv.org/abs/2609.33102" target="_blank" rel="noopener noreferrer">infrastructure for multi-agent safety evaluations</a> (NeurIPS 2026), shown how <a href="https://arxiv.org/abs/2604.23459" target="_blank" rel="noopener noreferrer">architecture impacts misuse risk</a> in multi-agent systems (ICML 2026), and co-written a foundational <a href="https://arxiv.org/abs/2505.02077v2" target="_blank" rel="noopener noreferrer">taxonomy of multi-agent security risks</a>. I've also written on <a href="https://www.cooperativeai.com/post/lessons-from-multi-agent-safety-incidents" target="_blank" rel="noopener noreferrer">lessons from multi-agent safety incidents</a>, <a href="https://arxiv.org/abs/2604.23065" target="_blank" rel="noopener noreferrer">transparency into internal deployments</a>, and the <a href="https://lambheart.substack.com/p/south-korea-and-the-hbm-bottleneck" target="_blank" rel="noopener noreferrer">importance of South Korea</a> to US export control regimes.
          </p>
          <p>
            I was previously a <a href="https://www.matsprogram.org/" target="_blank" rel="noopener noreferrer">MATS</a><img src={faviconMats.src} alt="" class="org-favicon" aria-hidden="true" /> Fellow with the <a href="https://wittlab.ai/" target="_blank" rel="noopener noreferrer">Oxford Witt Lab</a><img src={faviconWittLab.src} alt="" class="org-favicon" aria-hidden="true" /> and a Research Fellow at <a href="https://xrisk.uchicago.edu/" target="_blank" rel="noopener noreferrer">UChicago XLab</a><img src={faviconXlab} alt="" class="org-favicon" aria-hidden="true" />. During my undergrad at UW–Madison, I was Director of the <a href="https://waisi.org/" target="_blank" rel="noopener noreferrer">Wisconsin AI Safety Initiative</a><img src={faviconWaisi.src} alt="" class="org-favicon" aria-hidden="true" /> and a Research Fellow with Prof. <a href="https://pages.stat.wisc.edu/~zhong35/" target="_blank" rel="noopener noreferrer">Yiqiao Zhong</a>. I've mentored for <a href="https://erafellowship.org/" target="_blank" rel="noopener noreferrer">ERA</a>, XLab, <a href="https://sparai.org/" target="_blank" rel="noopener noreferrer">SPAR</a>, and <a href="https://pathfinder.kairos-project.org/" target="_blank" rel="noopener noreferrer">Pathfinder</a>.
          </p>
          <p>
            I like wearing many hats, connecting people, and being a <a href="https://en.wikipedia.org/wiki/Rubber_duck_debugging" target="_blank" rel="noopener noreferrer">rubber duck</a>.
             I’m a fan of memorizing <a href="/poetry">sonnets</a>, collecting, swimming, PRs (lifting and code), good vegetarian food, being with friends, hiking, deeply inspecting leaves, and Minnesota sports teams.
          </p>
        </div>
      </header>

      <hr class="rule ornament" />

      <p class="collections">
        <span class="collection-label">Mentors</span>
        <a href="https://lewishammond.com/" target="_blank" rel="noopener noreferrer">Dr. Lewis Hammond</a>,
        <a href="https://wittlab.ai/author/christian-schroeder-de-witt/" target="_blank" rel="noopener noreferrer">Dr. Christian Schroeder de Witt</a>,
        <a href="https://pages.stat.wisc.edu/~zhong35/" target="_blank" rel="noopener noreferrer">Prof. Yiqiao Zhong</a>,
        <a href="https://www.linkedin.com/in/john-bradley-059b4aa2/" target="_blank" rel="noopener noreferrer">John Bradley</a>.
        <span class="collection-label">Friends</span>
        <a href="https://www.cnas.org/people/ben-hayum" target="_blank" rel="noopener noreferrer">Ben</a>,
        <a href="https://jeremykintana.com/" target="_blank" rel="noopener noreferrer">Jeremy</a>,
        <a href="https://yixiong.dev/" target="_blank" rel="noopener noreferrer">Yixiong</a>,
        <a href="https://yeedrag.github.io/" target="_blank" rel="noopener noreferrer">Andy</a>,
        <a href="https://joneedssleep.github.io/" target="_blank" rel="noopener noreferrer">J-Train</a>,
        <a href="https://jasminexli.com/" target="_blank" rel="noopener noreferrer">J-Test</a>, <em>inter alia</em>.
        <span class="collection-label">Art</span>
        <a href="https://en.wikipedia.org/wiki/Impression,_Sunrise" target="_blank" rel="noopener noreferrer">Monet</a>, <a href="/poetry">Shakespeare</a>, <a href="https://www.tolkiensociety.org/discover/books-by-tolkien/" target="_blank" rel="noopener noreferrer">Tolkien</a>, <a href="https://www.youtube.com/watch?v=dQsjAbZDx-4" target="_blank" rel="noopener noreferrer">ABBA</a>, <a href="https://www.youtube.com/watch?v=ieRQyyPowH0" target="_blank" rel="noopener noreferrer">Ravel</a>, <a href="https://civilization.fandom.com/wiki/Shoshone_(Civ5)" target="_blank" rel="noopener noreferrer">Civilization V</a>, <a href="https://www.youtube.com/watch?v=JHFXG3r_0B8" target="_blank" rel="noopener noreferrer">Monty Python</a>, <a href="https://www.phys.ufl.edu/~thorn/grooks.html" target="_blank" rel="noopener noreferrer">Grooks</a>.
      </p>

      <footer class="site-footer">
        <div class="site-chain">
          <!-- Static src carries the light-theme params as a no-JS fallback; the
               script below rebuilds it from the CSS variables (see :root in
               global.css) and re-applies it whenever the theme toggles. -->
          <iframe src="https://waisi.live/embed/will/?text_color=%236b6458&link_color=%236b6458&border_color=%23dcd2bb&background=%23f7f2e6&font=%27Lora%27%2C+Georgia%2C+serif&font_size=14.4px"
                  data-embed="https://waisi.live/embed/will/"
                  title="waisi.live webring"
                  loading="lazy"></iframe>
        </div>
        <p>© 2026 <span class="signature">W.L.A.</span></p>
      </footer>
    </main>

    <div id="note-popover" class="note-popover" role="tooltip"></div>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const emailContainer = document.getElementById('email-container');
        if (emailContainer) {
          const user = 'william.anderson';
          const domain = 'cooperativeai';
          const tld = 'org';
          const link = document.createElement('a');
          link.href = 'mailto:' + user + '@' + domain + '.' + tld;
          link.textContent = user + ' [at] ' + domain + ' [dot] ' + tld;
          emailContainer.innerHTML = '';
          emailContainer.appendChild(link);
        }

        const popover = document.getElementById('note-popover');
        if (!popover) return;
        let hideTimer: number | null = null;

        function positionPopover(marker: Element) {
          const rect = marker.getBoundingClientRect();
          const popWidth = popover!.offsetWidth;
          const popHeight = popover!.offsetHeight;
          const scrollX = window.scrollX;
          const scrollY = window.scrollY;
          let left = rect.left + scrollX + rect.width / 2 - popWidth / 2;
          const top = rect.top + scrollY - popHeight - 10;
          const minLeft = scrollX + 8;
          const maxLeft = scrollX + document.documentElement.clientWidth - popWidth - 8;
          left = Math.max(minLeft, Math.min(maxLeft, left));
          popover!.style.left = left + 'px';
          popover!.style.top = top + 'px';
        }

        function showPopover(marker: Element) {
          if (hideTimer !== null) {
            clearTimeout(hideTimer);
            hideTimer = null;
          }
          popover!.textContent = marker.getAttribute('data-note') || '';
          popover!.classList.add('active');
          requestAnimationFrame(function () { positionPopover(marker); });
        }

        function scheduleHide() {
          if (hideTimer !== null) clearTimeout(hideTimer);
          hideTimer = window.setTimeout(function () {
            popover!.classList.remove('active');
            hideTimer = null;
          }, 300);
        }

        function cancelHide() {
          if (hideTimer !== null) {
            clearTimeout(hideTimer);
            hideTimer = null;
          }
        }

        document.querySelectorAll('sup.note').forEach(function (marker) {
          marker.addEventListener('mouseenter', function () { showPopover(marker); });
          marker.addEventListener('mouseleave', scheduleHide);
          marker.addEventListener('focus', function () { showPopover(marker); });
          marker.addEventListener('blur', scheduleHide);
        });

        popover.addEventListener('mouseenter', cancelHide);
        popover.addEventListener('mouseleave', scheduleHide);
      });
    </script>

    <script>
      // The waisi.live webring embed reads colours and type from query params,
      // so we rebuild its URL from our CSS variables and again whenever the
      // theme toggles.
      (function () {
        const frame = document.querySelector<HTMLIFrameElement>('.site-chain iframe');
        const footer = frame?.closest<HTMLElement>('.site-footer');
        if (!frame || !footer) return;
        const base = frame.getAttribute('data-embed') || '';

        function themedUrl(): string {
          const root = getComputedStyle(document.documentElement);
          const cssVar = (name: string) => root.getPropertyValue(name).trim();
          const params = new URLSearchParams({
            text_color: cssVar('--muted'),
            link_color: cssVar('--muted'),
            border_color: cssVar('--rule'),
            // The embed declares no color-scheme, so in dark mode the browser
            // paints an opaque light backdrop behind its transparent page;
            // passing our background colour covers it.
            background: cssVar('--bg'),
            font: cssVar('--serif-display'),
            font_size: getComputedStyle(footer).fontSize,
          });
          return base + '?' + params.toString();
        }

        function apply() {
          const url = themedUrl();
          if (frame.src !== url) frame.src = url;
        }

        apply();
        new MutationObserver(apply).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      })();
    </script>
  </body>
</html>
